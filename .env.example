# Backend
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=

# Emedix-Webhooks
API_KEY=

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=

# Admin Authentication
