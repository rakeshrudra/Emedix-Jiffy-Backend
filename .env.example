ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_REFRESH_EXPIRES_IN=30d
ENABLE_ADMIN_SIGNUP=true

# Maps
GOOGLE_MAPS_API_KEY=

# Firebase Auth
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Swil ERP — Order Download API (fill once Swil provides their endpoint)
SWIL_ORDER_DOWNLOAD_URL=
